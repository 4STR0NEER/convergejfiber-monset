# Copy to .env (never commit .env). Leave the Supabase values empty to run in demo mode.

# Browser app (public values: the anon key is safe to ship, RLS protects the data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Force demo mode even when Supabase is configured (pitch on a laptop, no backend)
VITE_DEMO_MODE=false
# Show the seeded demo accounts on the sign-in screen (staging demo only, never production)
VITE_SHOW_DEMO_ACCOUNTS=false
# Converge staff single sign-on, off until confirmed (Q40): google, azure, or both comma-separated
VITE_SSO_PROVIDERS=

# Seed script only (npm run seed:supabase). Server secret: never in VITE_ variables, never committed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
